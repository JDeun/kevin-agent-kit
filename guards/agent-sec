#!/bin/sh
set -eu
root=$(CDPATH="" cd -- "$(dirname -- "$0")/.." && pwd)
module=guards
if [ ! -f "$root/project.toml" ]; then
    module="$(basename -- "$root").guards"
    root=$(dirname -- "$root")
fi
export PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -P -m "$module" agent-sec scan "$@"
